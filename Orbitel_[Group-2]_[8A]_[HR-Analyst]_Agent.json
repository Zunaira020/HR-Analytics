            {
              "content": "=You are a CV parser. Extract the following fields from the CV and return ONLY a JSON object:\n\n{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"phone\": \"\",\n  \"skills\": \"\",\n  \"experience_years\": \"\",\n  \"education\": \"\",\n  \"score\": 0\n}\n\nScore 1-10 based on skills and experience.\n\nCV Text:\n{{ $('Extract from File').item.json.text }}"
            },
            {}
          ]
        },
        "builtInTools": {},
        "options": {}
      },
