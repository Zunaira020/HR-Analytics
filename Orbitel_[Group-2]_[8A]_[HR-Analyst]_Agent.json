    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\n\n// Navigate the exact n8n OpenAI response structure\nlet aiResponse = '';\n\ntry {\n  // Try the most common n8n OpenAI path\n  aiResponse = inputJson.output[0].content[0].text;\n} catch(e1) {\n  try {\n    aiResponse = inputJson.content[0].text;\n  } catch(e2) {\n    try {\n      aiResponse = inputJson.text;\n    } catch(e3) {\n      aiResponse = JSON.stringify(inputJson);\n    }\n  }\n}\n\n// Log what we got so we can debug\nconsole.log('AI Response:', aiResponse.substring(0, 200));\n\n// Find and parse JSON from the response\nlet parsed;\ntry {\n  const match = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('No JSON found');\n  parsed = JSON.parse(match[0]);\n} catch(e) {\n  return [{ json: {\n    debug_raw: aiResponse.substring(0, 300),\n    name: \"Parse Error\",\n    email: \"\",\n    phone: \"\",\n    skills: \"\",\n    experience_years: \"\",\n    education: \"\",\n    score: 0\n  }}];\n}\n\nparsed.score = Number(parsed.score) || 0;\n\nreturn [{ json: parsed }];\n\n\n"
      },
